rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // Helper: authenticated admin
    // --------------------------------------------------
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --------------------------------------------------
    // Admin records
    // --------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAdmin() && request.auth.uid == adminId;
      allow write: if false;
    }

    // --------------------------------------------------
    // Tourist profiles / location status
    // --------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin()
                  || (request.auth != null && request.auth.uid == userId);

      allow create, update: if request.auth != null
                            && request.auth.uid == userId;

      allow delete: if false;
    }

    // --------------------------------------------------
    // SOS alerts
    // --------------------------------------------------
    match /sos_alerts/{alertId} {
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.userId == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if false;
    }

    // --------------------------------------------------
    // Safe zones
    // --------------------------------------------------
    match /safe_zones/{safeZoneId} {
      allow read: if isAdmin() || request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------
    // Danger zones
    // --------------------------------------------------
    match /danger_zones/{dangerZoneId} {
      allow read, write: if isAdmin();
    }

    // --------------------------------------------------
    // Geofence alerts
    // --------------------------------------------------
    match /geo_fence_alerts/{alertId} {
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.userId == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if false;
    }

    // --------------------------------------------------
    // Tourist emergency contacts
    // --------------------------------------------------
    match /emergency_contacts/{userId} {
      allow read, write: if request.auth != null
                           && request.auth.uid == userId;

      match /contacts/{contactId} {
        allow read, create, update, delete: if request.auth != null
                                             && request.auth.uid == userId;
      }
    }

    // --------------------------------------------------
    // Deny everything else
    // --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
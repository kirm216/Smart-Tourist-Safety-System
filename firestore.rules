rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['approvalStatus']) ||
          request.resource.data.approvalStatus == 'pending');
      allow update: if (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['approvalStatus']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['approvalStatus']) &&
          request.resource.data.approvalStatus in ['approved', 'rejected']
        ) || (
          isSignedIn() &&
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['approvalStatus'])
        );
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
    }

    match /{topLevelCollection}/{document=**} {
      allow read, write: if isSignedIn() &&
        topLevelCollection != 'users' &&
        topLevelCollection != 'admins';
    }
  }
}
